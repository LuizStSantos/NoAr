diff --git a/backend/engine/src/output/gstreamer_output.rs b/backend/engine/src/output/gstreamer_output.rs
--- a/backend/engine/src/output/gstreamer_output.rs
+++ b/backend/engine/src/output/gstreamer_output.rs
@@ -1054,6 +1054,32 @@
             self.clock
                 .wait_until(Some(pts), self.config.video_time_base);
         }
+        // Test-worktree instrumentation only: preserve the exact compositor
+        // input to the encoder without changing pixels, PTS or controls.
+        if let Some(directory) = std::env::var_os("NOAR_QA_CAPTURE_DIR") {
+            use std::io::Write;
+
+            ensure!(
+                std::env::var("NOAR_E2E_DISPOSABLE").as_deref() == Ok("1"),
+                "pre-encode capture requires disposable staging"
+            );
+
+            if pts < 1_000 {
+                ensure!(frame.format() == PixelFormat::Yuv420p, "expected YUV420P");
+                let path = std::path::PathBuf::from(directory).join(format!("{pts:06}.yuv"));
+                let mut file = std::fs::File::create(path)?;
+
+                for plane in 0..frame.planes() {
+                    for row in frame
+                        .data(plane)
+                        .chunks_exact(frame.stride(plane))
+                        .take(frame.plane_height(plane) as usize)
+                    {
+                        file.write_all(&row[..frame.plane_row_bytes(plane)])?;
+                    }
+                }
+            }
+        }
         let mut buffer = packed_video_buffer(frame)?;
         let writable = buffer.get_mut().context("video buffer is shared")?;
         writable.set_pts(clock_time(pts, self.config.video_time_base));
